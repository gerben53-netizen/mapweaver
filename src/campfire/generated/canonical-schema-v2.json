{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campfire.local/schemas/campfire-map-contract-v2.schema.json",
  "title": "CAMPFIRE_MAPWEAVER v2",
  "description": "The Map Contract describes the world; Campfire/PixiJS determines how that world is rendered. No renderer or runtime state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "mapId",
    "revision",
    "name",
    "dimensions",
    "grid",
    "image",
    "walls",
    "doors"
  ],
  "properties": {
    "format": {
      "const": "CAMPFIRE_MAPWEAVER"
    },
    "version": {
      "const": 2
    },
    "mapId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pixelWidth",
        "pixelHeight"
      ],
      "properties": {
        "pixelWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "pixelHeight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        }
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sizePx",
        "feetPerCell"
      ],
      "properties": {
        "type": {
          "enum": [
            "SQUARE",
            "NONE"
          ]
        },
        "sizePx": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1024
        },
        "feetPerCell": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mimeType"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]*\\.(png|jpg|jpeg|webp)$"
        },
        "mimeType": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        }
      }
    },
    "walls": {
      "type": "array",
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "start",
          "end",
          "blocksVision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "start": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0
              },
              "y": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "end": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0
              },
              "y": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "blocksVision": {
            "type": "boolean"
          }
        }
      }
    },
    "doors": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "geometry",
          "blocksVisionWhenClosed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "geometry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "end": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "blocksVisionWhenClosed": {
            "type": "boolean"
          },
          "label": {
            "type": "string",
            "maxLength": 120
          }
        }
      }
    },
    "lighting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ambient",
        "lights"
      ],
      "properties": {
        "ambient": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intensity"
          ],
          "properties": {
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "lights": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "position",
              "radiusFt",
              "intensity",
              "color",
              "affectsVision",
              "enabled"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "type": {
                "const": "point"
              },
              "position": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "radiusFt": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 500
              },
              "intensity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "affectsVision": {
                "type": "boolean"
              },
              "enabled": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "windows": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "geometry",
          "wallId",
          "transmitsExteriorLight"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "geometry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "end": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "wallId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "transmitsExteriorLight": {
            "type": "boolean"
          },
          "exteriorLightTransmission": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
