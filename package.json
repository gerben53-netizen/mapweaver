{
  "name": "mapweaver",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "validate-asset-pack": "node scripts/validate-asset-pack.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:campfire-contract && tsc -b && vite build && npm run build:service && node scripts/check-font-resources.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.service.json",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "test:e2e": "node tests/persistence/acceptance.mjs initial",
    "audit:fixtures": "node scripts/audit-fixtures.mjs",
    "dev:service": "npm run build:service && npm start",
    "build:service": "tsc -p tsconfig.service.json && vite build --config vite.service.config.ts",
    "start": "node dist-service/main.js",
    "test:service": "vitest run --config vitest.service.config.ts",
    "build:client": "tsc -b && vite build",
    "build:launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File launcher/build.ps1",
    "package:windows": "npm run build && node scripts/package-windows.mjs",
    "package:installer": "node scripts/build-installer.mjs",
    "checksums:windows": "node scripts/package-checksums.mjs",
    "check:campfire-contract": "node scripts/check-campfire-contract.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "better-sqlite3": "^13.0.3",
    "bezier-js": "6.1.4",
    "dexie": "^4.4.6",
    "fastify": "^5.12.5",
    "fflate": "^0.8.3",
    "konva": "^10.6.0",
    "polygon-clipping": "0.15.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.3.0",
    "sharp": "^0.35.4",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bezier-js": "4.1.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
